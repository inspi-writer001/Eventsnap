		"devdoc": {
			"kind": "dev",
			"methods": {
				"createEvent(string,string)": {
					"details": "Create a new event with a name and banner (e.g. IPFS URL)."
				},
				"deleteEvent(uint256)": {
					"details": "Delete an entire event from storage. Only the global contract owner can do this."
				},
				"deleteImage(uint256,uint256)": {
					"details": "Delete one of your images (and its corresponding tag) by array index.      - Allowed if caller is:         (a) the image uploader themself,         (b) the event owner, or         (c) the global contract owner.      If you'd like event/global owner to delete images from *any* user,       adjust logic to pass in 'targetUser' as a parameter (instead of msg.sender)."
				},
				"getEvent(uint256)": {
					"details": "Get basic details about an event."
				},
				"getUserImages(uint256,address)": {
					"details": "Get all images (and corresponding tags) that a user uploaded for a specific event."
				},
				"joinEvent(uint256,string)": {
					"details": "Join an event, providing a selfie link (e.g., IPFS URL).      Initializes the user's struct, setting up empty arrays for images & tags."
				},
				"uploadImageWithTag(uint256,string,string)": {
					"details": "Upload (add) an image and a tag to an event you've joined.      'imageUrl' usually an IPFS CID or any link.       'tagValue' is the corresponding tag (e.g. \"concert\", \"VIP\", etc.)."
				}
			},
