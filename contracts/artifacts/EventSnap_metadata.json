		"devdoc": {
			"kind": "dev",
			"methods": {
				"createEvent(string,string)": {
					"details": "Creates an event, increments the counter, generates a unique UID, and returns the UID."
				},
				"deleteEvent(uint256)": {
					"details": "Deletes an entire event. Only the global contract owner can do this."
				},
				"deleteImage(uint256,uint256)": {
					"details": "Deletes one image (and its tag) from a user's uploads."
				},
				"getAllEventImages(uint256)": {
					"details": "Returns all images (and tags) from all attendees of an event."
				},
				"getEvent(uint256)": {
					"details": "Returns event details, including its UID."
				},
				"getHighlights(uint256)": {
					"details": "Retrieves the highlight images for an event."
				},
				"getUserImages(uint256,address)": {
					"details": "Returns all images (and tags) a user has uploaded for a specific event."
				},
				"joinEvent(uint256,string)": {
					"details": "Allows a user to join an event by providing their selfie."
				},
				"setHighlights(uint256,string[])": {
					"details": "Sets the highlight images for an event. Only the designated oracle can call this."
				},
				"setOracle(address)": {
					"details": "Allows the owner to update the oracle address."
				},
				"uploadImageWithTag(uint256,string,string)": {
					"details": "Uploads an image with an associated tag."
				}
			},
			"version": 1
		},
